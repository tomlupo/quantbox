  # A PAPER replication names no book: it is anchored to the paper instead
  # (qute-research skills/research/references/preregistration.md § A paper replication)
  kind: replication
  paper:
    ref: <DOI or URL>
    sample: {start: <YYYY-MM>, end: <YYYY-MM>}       # the paper's own window
    reported:                                        # the paper's numbers being replicated
      - metric: <metric>
        value: <number>
    # reference_series: <the authors' public series>   # optional
    post_sample: {start: <YYYY-MM>, end: <YYYY-MM>}  # right after the sample, >= 3 years
