{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quantbox/data-validation@1",
  "title": "quantbox data validation (data-validation@1)",
  "description": "<run_dir>/data_validation.json, written by backtest.pipeline.v1 (ADR-0007): what each missing price meant, the execution calendar, decision vs execution timing, input staleness, decision weight age, index alignment and leverage. Minors: 1 adds weight_age; 2 makes leverage.max_net_exposure_unscaled, scaled_after_deferral and buys_zeroed_dates (always written since minor 0) required; 3 adds index_alignment; 4 adds threshold and leverage.mode none (execution.schedule bars, ADR-0008); 5 adds rebalancing and groups (TOM-1450). The stable shape the data-validation step (TOM-1430) reads. VERSIONING as run@1: adding a field is MINOR (x-schema-minor), renaming, removing or changing a meaning is MAJOR (data-validation@2).",
  "x-schema-minor": 5,
  "type": "object",
  "required": ["schema", "calendar", "execution_calendar", "timing", "staleness", "leverage"],
  "properties": {
    "schema": {"const": "quantbox/data-validation@1"},
    "calendar": {
      "type": "object",
      "required": ["policy", "n_bars", "n_instruments", "rows_without_any_price", "totals", "legacy_coverage_drop", "instruments"],
      "properties": {
        "policy": {"type": "object"},
        "n_bars": {"type": "integer", "minimum": 0},
        "n_instruments": {"type": "integer", "minimum": 0},
        "rows_without_any_price": {"type": "integer", "minimum": 0},
        "totals": {
          "type": "object",
          "required": ["ffilled_bars", "instruments_without_prices"],
          "properties": {
            "ffilled_bars": {"type": "integer", "minimum": 0},
            "instruments_without_prices": {"type": "array", "items": {"type": "string"}}
          }
        },
        "legacy_coverage_drop": {
          "type": "object",
          "required": ["rule", "count", "columns"],
          "properties": {
            "rule": {"type": "string"},
            "count": {"type": "integer", "minimum": 0},
            "columns": {"type": "array", "items": {"type": "string"}}
          }
        },
        "instruments": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["first_valid", "last_valid", "window_bars", "observed_bars", "ffilled_bars"],
            "properties": {
              "first_valid": {"type": ["string", "null"]},
              "last_valid": {"type": ["string", "null"]},
              "window_bars": {"type": "integer", "minimum": 0},
              "observed_bars": {"type": "integer", "minimum": 0},
              "ffilled_bars": {"type": "integer", "minimum": 0},
              "deferred_trades": {"type": "integer", "minimum": 0},
              "targeted_outside_window_bars": {"type": "integer", "minimum": 0},
              "max_abs_weight_outside_window": {"type": "number", "minimum": 0},
              "stale_decisions": {"type": "integer", "minimum": 0},
              "max_staleness_bars": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    "execution_calendar": {
      "type": "object",
      "required": ["calendar", "execution_bars", "total_bars", "non_execution_bars_by_year"],
      "properties": {
        "calendar": {"type": "string", "minLength": 1},
        "execution_bars": {"type": "integer", "minimum": 0},
        "total_bars": {"type": "integer", "minimum": 0},
        "non_execution_bars_by_year": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
      }
    },
    "timing": {
      "type": "object",
      "required": ["lag_bars", "lag_counted_in", "decisions", "executed_decisions", "decisions_past_last_bar", "deferred_trades", "targeted_outside_window_bars"],
      "properties": {
        "decision_calendar": {"const": "execution"},
        "lag_bars": {"type": "integer", "minimum": 0},
        "lag_counted_in": {"const": "execution-calendar bars"},
        "decisions": {"type": "integer", "minimum": 0},
        "executed_decisions": {"type": "integer", "minimum": 0},
        "decisions_past_last_bar": {"type": "integer", "minimum": 0},
        "deferred_trades": {"type": "integer", "minimum": 0},
        "targeted_outside_window_bars": {"type": "integer", "minimum": 0},
        "instruments_targeted_outside_window": {"type": "array", "items": {"type": "string"}}
      }
    },
    "staleness": {
      "type": "object",
      "required": ["instrument_decisions", "stale_decisions", "max_bars", "p95_bars"],
      "properties": {
        "instrument_decisions": {"type": "integer", "minimum": 0},
        "stale_decisions": {"type": "integer", "minimum": 0},
        "max_bars": {"type": "integer", "minimum": 0},
        "p95_bars": {"type": "number", "minimum": 0}
      }
    },
    "weight_age": {
      "type": "object",
      "description": "Minor 1 (ADR-0007 1c): on a CALENDAR schedule (one period-end offset), executed decisions that MISSED a weight step the strategy stamped on a non-execution bar after the decision bar, in the decision's own calendar period, and held unchanged to the next execution bar. measured=false (with reason, no counts) on an int / explicit-date schedule, rsims or buy-and-hold: there is no period. stale_held_bars_*: bars from a stale decision's execution to the next decision's execution. Recorded, never refused.",
      "required": ["rule", "measured", "decisions"],
      "properties": {
        "rule": {"type": "string"},
        "measured": {"type": "boolean"},
        "reason": {"type": "string"},
        "decisions": {"type": "integer", "minimum": 0, "description": "Executed decisions."},
        "stale_decisions": {"type": "integer", "minimum": 0},
        "first_stale": {"type": "array", "items": {"type": "string"}, "maxItems": 5},
        "first_missed_stamps": {"type": "array", "items": {"type": "string"}, "maxItems": 5},
        "stale_held_bars_max": {"type": "integer", "minimum": 0},
        "stale_held_bars_total": {"type": "integer", "minimum": 0}
      }
    },
    "index_alignment": {
      "type": "object",
      "description": "Minor 3 (ADR-0007 1c): what the price/weight index intersection dropped. warmup_* = price bars before the strategy's first row (not warned); price_bars_dropped = any other price bar with no weight row; weight_rows_dropped = weight rows on dates with no price bar (data only: a step stamped there is weight_age's to judge). Only dropped price bars are warned.",
      "required": ["price_bars", "weight_rows", "bars_used", "warmup_price_bars_dropped", "price_bars_dropped", "first_price_bars_dropped", "weight_rows_dropped"],
      "properties": {
        "price_bars": {"type": "integer", "minimum": 0},
        "weight_rows": {"type": "integer", "minimum": 0},
        "bars_used": {"type": "integer", "minimum": 0},
        "warmup_price_bars_dropped": {"type": "integer", "minimum": 0},
        "price_bars_dropped": {"type": "integer", "minimum": 0},
        "first_price_bars_dropped": {"type": "array", "items": {"type": "string"}, "maxItems": 5},
        "weight_rows_dropped": {"type": "integer", "minimum": 0}
      }
    },
    "leverage": {
      "type": "object",
      "required": ["mode", "rebalances", "rebalances_above_net_1", "max_net_exposure_decided", "max_net_exposure_unscaled", "max_net_exposure_held", "scaled_rebalances", "scaled_after_deferral", "buys_zeroed_rebalances", "buys_zeroed_dates", "scale_mean", "scale_min", "scale_max"],
      "properties": {
        "mode": {"enum": ["normalize", "borrow", "none"]},
        "rebalances": {"type": "integer", "minimum": 0},
        "rebalances_above_net_1": {"type": "integer", "minimum": 0},
        "max_net_exposure_decided": {"type": "number"},
        "max_net_exposure_unscaled": {"type": "number", "description": "The largest net exposure a rebalance would have HELD (ordered cells at target, deferred cells at their previous weight) before venue.leverage."},
        "max_net_exposure_held": {"type": "number", "description": "The largest net exposure held after venue.leverage."},
        "scaled_after_deferral": {"type": "integer", "minimum": 0, "description": "Scaled rebalances on which a deferred cell kept its weight."},
        "buys_zeroed_rebalances": {"type": "integer", "minimum": 0, "description": "Rebalances where the deferred cells alone held net exposure at or above 1, so every ordered buy was set to 0."},
        "buys_zeroed_dates": {"type": "array", "items": {"type": "string"}},
        "scaled_rebalances": {"type": "integer", "minimum": 0},
        "scale_mean": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "scale_min": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "scale_max": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    },
    "threshold": {
      "type": "object",
      "description": "Present only when the run declares a threshold (minor 4, ADR-0008): the seam's drift trigger — a scheduled rebalance is placed only when an ordered instrument's cost-free drifted weight is more than the threshold from its target.",
      "required": ["threshold", "scheduled_rebalances", "placed_rebalances", "skipped_rebalances"],
      "properties": {
        "threshold": {"type": "number", "minimum": 0},
        "rule": {"type": "string"},
        "scheduled_rebalances": {"type": "integer", "minimum": 0},
        "placed_rebalances": {"type": "integer", "minimum": 0},
        "skipped_rebalances": {"type": "integer", "minimum": 0},
        "first_skipped": {"type": "array", "items": {"type": "string"}}
      }
    },
    "rebalancing": {
      "type": "object",
      "description": "Present only when the run declares rebalancing_policy (minor 5, TOM-1450): the policy (periodic, tranche, band, corridor; quantbox.engine.policy) and what it did. scheduled = bars with orders before the drift trigger, placed = after it, partial = bars on which a corridor traded only some instruments.",
      "required": ["policy", "scheduled_rebalances", "placed_rebalances", "skipped_rebalances", "partial_rebalances"],
      "properties": {
        "policy": {
          "type": "object",
          "required": ["policy", "frequency", "calendar"],
          "properties": {
            "policy": {"enum": ["periodic", "tranche", "band", "corridor"]},
            "calendar": {"type": ["string", "null"]},
            "tranches": {"type": "integer", "minimum": 2},
            "band": {"type": "number", "exclusiveMinimum": 0},
            "width": {"type": "array", "items": {"type": "number", "minimum": 0}},
            "bounds": {"type": "object"}
          }
        },
        "execution_bars_outside_market_sessions": {"type": "integer", "minimum": 0},
        "scheduled_rebalances": {"type": "integer", "minimum": 0},
        "placed_rebalances": {"type": "integer", "minimum": 0},
        "skipped_rebalances": {"type": "integer", "minimum": 0},
        "partial_rebalances": {"type": "integer", "minimum": 0},
        "first_skipped": {"type": "array", "items": {"type": "string"}},
        "tranches": {"type": "integer", "minimum": 2}
      }
    },
    "groups": {
      "type": "object",
      "description": "Present only when the run declares group_limits (minor 5, TOM-1450): the limits on each group's gross weight in the decided book (quantbox.engine.groups) and how many rows they changed.",
      "required": ["by", "excess", "limits", "rows", "rows_adjusted", "flat_rows"],
      "properties": {
        "by": {"type": "string"},
        "excess": {"enum": ["redistribute", "cash"]},
        "limits": {"type": "object"},
        "rows": {"type": "integer", "minimum": 0},
        "rows_adjusted": {"type": "integer", "minimum": 0},
        "flat_rows": {"type": "integer", "minimum": 0},
        "max_gross_cut_to_cash": {"type": "number", "minimum": 0},
        "groups": {"type": "object"}
      }
    },
    "variants": {
      "type": "object",
      "description": "Variants flow only: each variant's timing, staleness and leverage (their targets differ); the top level is the primary variant's.",
      "additionalProperties": {"type": "object", "required": ["timing", "staleness", "leverage"]}
    }
  }
}
